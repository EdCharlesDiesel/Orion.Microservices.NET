          {
            "name": "apiKey",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/MacroData"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MacroData"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/MacroData"
                }
              }
            }
          }
        }
      }
    },
