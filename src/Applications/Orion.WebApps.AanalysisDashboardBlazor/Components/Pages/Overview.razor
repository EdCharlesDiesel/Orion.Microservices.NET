@page "/"
@using Orion.WebApps.AanalysisDashboardBlazor.Models
@using Orion.WebApps.AanalysisDashboardBlazor.Services


<MudText Typo="Typo.h4" Class="mb-4">📊 Performance Overview</MudText>

@if (_loading)
{
    <MudProgressCircular Indeterminate Size="Size.Large" Class="d-flex justify-center" />
}
else
{
    <MudGrid>
        @foreach (var pair in new[] { "EUR/USD", "GBP/USD", "USD/JPY", "XAU/USD" })
        {
            var data = _dailyData.ContainsKey(pair) ? _dailyData[pair] : null;
            if (data != null && data.Any())
            {
                var price = data.Last().Close;
                var change = (data.Last().Close - data[^2].Close) / data[^2].Close * 100;
                
                <MudItem xs="12" sm="6" md="3">
                    <MudPaper Class="pa-4 text-center">
                        <MudText Typo="Typo.h6">@pair</MudText>
                        <MudText Typo="Typo.h4">@price.ToString("F4")</MudText>
                        <MudText Typo="Typo.body2" Class="@(change >= 0 ? "text-success" : "text-error")">
                            @(change >= 0 ? "▲" : "▼") @Math.Abs(change).ToString("F2")%
                        </MudText>
                    </MudPaper>
                </MudItem>
            }
        }
    </MudGrid>

    <MudGrid>
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6">US GDP Growth</MudText>
                <MudText Typo="Typo.h3">@_macroData.USD.GDP.ToString("F1")%</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6">US Inflation (CPI)</MudText>
                <MudText Typo="Typo.h3">@_macroData.USD.Inflation.ToString("F1")%</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6">Fed Funds Rate</MudText>
                <MudText Typo="Typo.h3">@_macroData.USD.Rates.ToString("F2")%</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudGrid>
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6">Trading Sessions</MudText>
                <MudText Class="mt-2">
                    @if (IsLondonSession())
                    {
                        <MudChip Color="Color.Success" Size="Size.Medium">🔴 London Session: ACTIVE</MudChip>
                    }
                    else
                    {
                        <MudChip Color="Color.Default" Size="Size.Medium">⚫ London Session: Closed</MudChip>
                    }
                </MudText>
                <MudText Class="mt-2">
                    @if (IsNySession())
                    {
                        <MudChip Color="Color.Success" Size="Size.Medium">🟢 New York Session: ACTIVE</MudChip>
                    }
                    else
                    {
                        <MudChip Color="Color.Default" Size="Size.Medium">⚫ New York Session: Closed</MudChip>
                    }
                </MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    private bool _loading = true;
    private Dictionary<string, List<MarketData>> _dailyData = new();
    private MacroDataCollection _macroData = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        
        var (dataByTimeframe, _) = await DataService.LoadAllTimeframesAsync();
        _dailyData = dataByTimeframe.ContainsKey("Daily") ? dataByTimeframe["Daily"] : new Dictionary<string, List<MarketData>>();
        _macroData = await DataService.GetMacroDataAsync();
        
        _loading = false;
        StateHasChanged();
    }

    private bool IsLondonSession()
    {
        var hour = DateTime.Now.Hour;
        return hour >= 9 && hour <= 12;
    }

    private bool IsNySession()
    {
        var hour = DateTime.Now.Hour;
        return hour >= 13 && hour <= 16;
    }
}